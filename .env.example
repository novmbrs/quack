# Quack's settings (docs/design.md §17.7). Copy to .env and fill in the
# Discord values. Quack never reads .env itself: Compose passes it to the
# container (env_file), and for `cargo run` export it first, for example
#   set -a; . ./.env; set +a
# Real environment variables override the optional TOML file (--config).

# PostgreSQL. `docker compose up -d` serves it here; the Compose app
# profile overrides it with the container's address.
QUACK_DATABASE_URL=postgres://quack:quack@127.0.0.1:54418/quack
# Pool size (4-200).
#QUACK_DATABASE_MAX_CONNECTIONS=20

# Discord. Use a separate development application, not the production one.
QUACK_DISCORD_TOKEN=
# The application ID (also the OAuth client ID).
QUACK_DISCORD_APPLICATION_ID=
QUACK_DISCORD_CLIENT_SECRET=
# Register the slash commands to one test server only (applies at once).
#QUACK_DEV_GUILD_ID=

# Where the dashboard is reached. Add <QUACK_PUBLIC_URL>/api/auth/callback to
# the Discord application's OAuth2 redirects. http only for localhost.
QUACK_PUBLIC_URL=http://localhost:8080
# HTTP listen address.
QUACK_LISTEN_ADDR=127.0.0.1:8080
# 32 random bytes, base64: `openssl rand -base64 32`. Changing it signs
# everyone out.
QUACK_SESSION_SECRET=
# The built dashboard (apps/dashboard: `bun run build` writes dist/app).
QUACK_DASHBOARD_DIR=apps/dashboard/dist/app
# Proxies in front of Quack, for the client IP (0-5).
#QUACK_TRUSTED_PROXY_HOPS=0

# Telemetry. Unset: nothing is exported; logs still go to stderr. With the
# Compose telemetry profile: http://telemetry:4318 (from the app container)
# or http://localhost:4318 (from the host).
#QUACK_OTLP_ENDPOINT=
#QUACK_SERVICE_NAME=quack
QUACK_ENVIRONMENT=development
#QUACK_LOG_LEVEL=info

# Jobs running at once across all kinds (1-64).
#QUACK_WORKER_CONCURRENCY=16

# `quack import-mysql` only: the old Go database.
#QUACK_IMPORT_SOURCE_URL=mysql://quack:quack@127.0.0.1:3306/quack
