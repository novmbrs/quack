{
  "db_name": "PostgreSQL",
  "query": "SELECT j.id, j.kind, j.key, j.guild_id, j.attempts, j.last_error, j.dead_at\n               FROM jobs j, ops_state s\n               WHERE j.dead_at > s.dead_jobs_seen_until AND j.dead_at <= $1 AND j.kind <> 'post_ops'\n               ORDER BY j.dead_at, j.id",
