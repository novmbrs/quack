  "query": "UPDATE jobs SET ops_alerted_at = dead_at\n               WHERE dead_at IS NOT NULL AND kind <> 'post_ops'\n                 AND (ops_alerted_at IS NULL OR ops_alerted_at < dead_at)\n               RETURNING id, kind, key, guild_id, attempts, last_error, dead_at",
