  "query": "SELECT c.rule_id, max(r.name) AS rule_name, count(*) AS \"n!\" FROM cases c\n               LEFT JOIN rules r ON r.id = c.rule_id\n               WHERE c.guild_id = $1 AND c.created_at >= $2 AND c.created_at < $3\n               GROUP BY c.rule_id ORDER BY 3 DESC",
