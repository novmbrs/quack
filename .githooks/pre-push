#!/bin/sh
# Runs the fast checks on what this push changes, so a red check is found
# here in seconds and not in CI in minutes. Turn the hooks on once per
# clone:  git config core.hooksPath .githooks
#
# Rust changes: format and clippy. Dashboard changes: format, lint, types.
# Tests stay in CI. Skip once with `git push --no-verify`.
set -eu

root=$(git rev-parse --show-toplevel)
cd "$root"

zero=0000000000000000000000000000000000000000
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a branch
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
        # A new branch: compare with where it left main.
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
        [ -n "$base" ] || base=$(git hash-object -t tree /dev/null)
    else
        base=$remote_sha
    fi
    changed="$changed
$(git diff --name-only "$base" "$local_sha")"
done

touches() { printf '%s\n' "$changed" | grep -Eq "$1"; }

if touches '^(crates/|\.sqlx/|Cargo\.(toml|lock)$|rust-toolchain\.toml$|clippy\.toml$|rustfmt\.toml$)'; then
    echo "pre-push: cargo fmt"
    cargo fmt --all --check
    echo "pre-push: cargo clippy"
    SQLX_OFFLINE=true cargo clippy --workspace --all-targets --locked -- -D warnings
fi

if touches '^apps/dashboard/'; then
    echo "pre-push: dashboard check"
    (cd apps/dashboard && bun run check)
fi
